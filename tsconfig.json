{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
, "app/(pages)/blog/[id]/page.jsx", "app/(pages)/training/[slug]/page.tsx", "app/(pages)/products/[slug]/page.jsx", "app/(pages)/products/[slug]/ProductDetailsClient.jsx", "app/page.jsx", "app/(pages)/training/[slug]/CourseDetailsClient.jsx"  ],
  "exclude": ["node_modules"]
}
